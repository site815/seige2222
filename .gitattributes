* text=auto
*.json text eol=lf
# Saves fingerprint the parsed rule content (SeigeCanonicalJson), so line endings
# no longer matter for compatibility; keep the authored bytes untouched anyway.
Rules/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
AIFILES/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
Interface/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
Graphics/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.uasset binary
*.umap binary
*.blend binary
*.fbx binary
*.png binary
Content/Art/NatureV04/SM_JacarandaA.uasset filter=lfs diff=lfs merge=lfs -text
Art/EnvironmentV04/Source/*.blend filter=lfs diff=lfs merge=lfs -text
Content/Art/NatureV07/SM_JacarandaNearV07.uasset filter=lfs diff=lfs merge=lfs -text
Art/EnvironmentV07/Source/SM_JacarandaNearV07.blend filter=lfs diff=lfs merge=lfs -text
# The companion-dog binaries (10-16 MB each) are ordinary Git objects: this
# project's cloud sessions can reach github.com but not GitHub's LFS object
# store (github-cloud.s3.amazonaws.com), so LFS uploads from them fail.
Content/Art/CompanionDog/SK_CompanionDog.uasset -filter -diff -merge binary
Art/CompanionDog/Source/CompanionDog.blend -filter -diff -merge binary
Art/CompanionDog/Source/generated/*.glb -filter -diff -merge binary
